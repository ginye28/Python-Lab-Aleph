    {
      "parameters": {
        "jsCode": "// 과제 2 판정 로직\n//\n// [!] 언어 선택 함정: 이 Code 노드에서 언어를 \"Python (Beta)\" 로 바꾸면\n//   - $json / $input 대신 밑줄이 붙은 _json / _input 을 써야 하고\n//   - requests 같은 일반 파이썬 라이브러리가 거의 없는 Pyodide(WASM) 환경이라\n//   이 코드를 그대로 붙여넣으면 NameError 로 바로 죽는다.\n//   실습과제 B4 채점 항목이니, 일부러 Python 으로 한번 돌려서 에러를 캡처해두고\n//   원인을 확인한 뒤 여기 JavaScript 로 완성하는 것을 권장한다.\n\nconst DENY_LEVEL = 10;  // 거부 기준 상수 — 이 숫자만 바꾸면 판정이 바뀐다 (B3)\n\nconst results = [];\n\nfor (const item of $input.all()) {\n  // Webhook 노드의 출력은 { headers, params, query, body } 형태다.\n  const src = item.json.body ?? item.json;\n  const student = src.student ?? 'unknown';\n  const alerts = src.alerts ?? [];\n\n  for (const a of alerts) {\n    const level = Number(a.level ?? 0);\n    let severity, decision;\n    if (level >= DENY_LEVEL) {\n      severity = 'High';\n      decision = 'deny';\n    } else if (level >= 7) {\n      severity = 'Medium';\n      decision = 'allow';\n    } else {\n      severity = 'Low';\n      decision = 'allow';\n    }\n\n    results.push({\n      json: {\n        student,\n        src_ip: a.ip,\n        level,\n        rule: a.rule,\n        fail_count: a.fail_count ?? 1,\n        severity,\n        decision,\n        reason: `level ${level} (rule ${a.rule}) \\u2192 ${decision}`,\n      },\n    });\n  }\n}\n\nreturn results;\n",
        "language": "javaScript"
      },
