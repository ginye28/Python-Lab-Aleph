      "name": "텔레그램"
    },
    {
      "parameters": {
        "jsCode": "// 웹훅으로 들어온 경보에 심각도(severity)를 매겨 다음 노드로 넘긴다.\n// Webhook 노드의 출력은 { headers, params, query, body } 형태이므로 body 를 꺼내 평탄화한다.\n// 등급 기준은 detect.py 와 동일하게 맞춘다.\n\nfunction severityOf(level) {\n  if (level >= 10) return 'High';\n  if (level >= 7)  return 'Medium';\n  return 'Low';\n}\n\nfor (const item of $input.all()) {\n  const src = item.json.body ?? item.json;   // 웹훅이면 body 안에, 직접 호출이면 그대로\n  const level = Number(src.level ?? 0);\n\n  item.json = {\n    ...src,\n    level,\n    severity: severityOf(level),\n  };\n}\n\nreturn $input.all();\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
