      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const b = (item.json ?? {}).body ?? item.json ?? {};\n  const host = b.host ?? '?';\n  const open = b.open ?? b.open_ports ?? [];\n  const openStr = Array.isArray(open) ? open.join(', ') : String(open);\n  const student = b.student ?? 'lsy';\n  const risky = openStr.includes('3306') || openStr.includes('9000');\n  const head = risky ? '🛰️🚨 [취약점 점검·주의]' : '🛰️ [취약점 점검]';\n  const text = `${head}${host}\\n열린 포트:${openStr} (학생${student})\\n` +\n               (risky ? '⚠ MySQL/SIEM 노출 — 바인딩·인증 점검 필요' : '노출 서비스 점검 권장');\n  out.push({ json: { text, host, open: openStr, student } });\n}\nreturn out;"
