    {
      "parameters": {
        "jsCode": "// 입력: Graylog HTTP Notification body  예: {user, rule, student, src_ip, granted_by}\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json ?? {};\n  const body = j.body ?? j;                              // Webhook 은 body 아래\n  const events = body.alerts ?? body.events ?? (body.user ? [body] : []);\n  for (const e of events) {\n    const user = e.user ?? e.username;\n    if (!user) continue;                                 // 대상 없으면 건너뜀\n    out.push({ json: {\n      username: user,\n      reason: `과잉권한 자동회수: ${e.rule ?? 'priv-unauthorized-admin'} (부여자 ${e.granted_by ?? '?'})`,\n      student: e.student ?? body.student ?? 'lsy',\n      severity: 'High',\n      src_ip: e.src_ip ?? '0.0.0.0',\n      source: 'privilege-guard',\n    }});\n  }\n}\nreturn out;"
      },
