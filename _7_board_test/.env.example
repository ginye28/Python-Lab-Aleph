# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   copy .env.example .env
# .env 는 .gitignore 에 있어서 커밋되지 않습니다. USB 나 비밀번호 관리자에 따로 보관하세요.

# ── 공공데이터포털 ────────────────────────────────
# 반드시 "일반 인증키(Decoding)" 를 넣으세요.
# Encoding 키를 넣어도 app.py 가 unquote() 로 풀어주긴 하지만 Decoding 쪽이 정석입니다.
PUBLIC_API_KEY=여기에_공공데이터포털_인증키

# ── LLM ──────────────────────────────────────────
LLM_API_KEY=여기에_LLM_API_키

# ── MySQL (docker-compose 가 읽음) ────────────────
MYSQL_ROOT_PASSWORD=여기에_DB_루트_비밀번호
MYSQL_DATABASE=github_db

# ── n8n (docker-compose 가 읽음) ──────────────────
# 아래 명령으로 한 번 만들고, 그 뒤로는 절대 바꾸지 마세요.
#   python -c "import secrets; print(secrets.token_hex(24))"
# 값이 바뀌면 저장된 자격증명을 복호화할 수 없습니다.
N8N_ENCRYPTION_KEY=여기에_랜덤_문자열

# ── n8n 워크플로가 쓰는 비밀값 ────────────────────────
# 노드의 URL 필드를 Expression 으로 바꿔 {{ $env.이름 }} 으로 참조합니다.
# 이렇게 하면 워크플로 JSON 에 비밀이 안 남아 public 저장소에도 커밋할 수 있습니다.
#
#   디스코드 URL   : {{ $env.DISCORD_WEBHOOK_URL }}
#   슬랙 URL       : {{ $env.SLACK_WEBHOOK_URL }}
#   텔레그램 URL   : https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage
#   텔레그램 chat_id: {{ $env.TELEGRAM_CHAT_ID }}

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
TELEGRAM_BOT_TOKEN=<봇ID>:<봇토큰>
TELEGRAM_CHAT_ID=<내_chat_id>

# ── Flask JWT ────────────────────────────────────────
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=여기에_랜덤_문자열

# ── 실습과제: 게시판 REST API ──
# python -c "import secrets; print(secrets.token_urlsafe(24))"
SECURITY_API_KEY=여기에_랜덤_문자열
STUDENT_NAME=본인이름

# ── _8_cafe_rbac_test: 과잉권한 회수봇(privilege_revoke_bot.py) ──
# 비워두면 SECURITY_API_KEY 를 같이 쓴다. 따로 두고 싶으면 값을 채운다.
ADMIN_API_KEY=
# 관리자로 있어도 되는 계정(쉼표로 구분). 비우면 모든 admin 이 위반으로 잡힌다.
ADMIN_ALLOWLIST=admin
BOARD_URL=http://localhost:5000
GRAYLOG_HOST=localhost
GRAYLOG_PORT=12201
# 디스코드 알림용 n8n 웹훅 (workflows/privilege-revoke-bot.json 을 Import 후 Publish)
PRIVILEGE_WEBHOOK_URL=http://localhost:5678/webhook/privilege-violations
STUDENT=본인이름
BOARD_SRC_IP=127.0.0.1
