      ],
      "webhookId": "fc247d23-0330-4280-b388-1efe8acca706"
    },
    {
      "parameters": {
        "jsCode": "// 회수봇(privilege_revoke_bot.py)이 보낸 위반 목록을 '건별 아이템'으로 펼친다.\n//\n// 여기서 아이템을 나눠 두는 것이 핵심이다. n8n 의 HTTP Request 노드는 들어온\n// 아이템 수만큼 실행되므로, 위반이 2건이면 회수 호출도 2번 나간다.\n// (Graylog 알림으로 트리거하면 backlog 중 1건만 읽게 되어 하나만 회수된다.)\n//\n// 들어오는 모양:\n//   { student, rule, src_ip, violations: [ { username, granted_by, role, role_name }, ... ] }\n\nconst results = [];\n\nfor (const item of $input.all()) {\n  // Webhook 노드의 출력은 { headers, params, query, body } 형태다.\n  const src = item.json.body ?? item.json;\n  const student = src.student ?? 'unknown';\n  const rule = src.rule ?? 'priv-unauthorized-admin';\n  const srcIp = src.src_ip ?? 'unknown';\n  const violations = src.violations ?? [];\n\n  for (const v of violations) {\n    const grantedBy = v.granted_by ?? 'unknown';\n    const roleName = v.role_name ?? '관리자';\n\n    results.push({\n      json: {\n        student,\n        rule,\n        src_ip: srcIp,\n        username: v.username,\n        granted_by: grantedBy,\n        role_name: roleName,\n        reason: `허용목록 밖 ${roleName} 권한 (부여자: ${grantedBy})`,\n        message:\n          `🚨 [과잉권한 탐지] '${v.username}' 계정이 허용목록 밖 ${roleName} 권한을 갖고 있습니다.\\n` +\n          `• 부여자: ${grantedBy}\\n` +\n          `• 탐지 규칙: ${rule}\\n` +\n          `• student: ${student}`,\n      },\n    });\n  }\n}\n\nreturn results;\n",
        "language": "javaScript"
      },
      "id": "0173f168-85d9-45e0-bdaa-bcfcced81171",
      "name": "위반 정리",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -820,
        260
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "={{ $json.message }}"
            }
          ]
        },
