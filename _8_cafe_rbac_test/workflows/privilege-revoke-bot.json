{
  "name": "과잉권한 회수봇 - 탐지/회수 알림",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "privilege-violations",
        "options": {}
      },
      "id": "e981f01e-0b16-4a58-bd70-0b72eceb3495",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
